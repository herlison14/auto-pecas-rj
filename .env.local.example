# ─── NEON POSTGRES ─────────────────────────────────────────
# Crie projeto em https://console.neon.tech/app/projects
# Region recomendada: aws-sa-east-1 (São Paulo)
# Copia a connection string "pooled" — termina em ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ─── NEXTAUTH / AUTH.JS V5 ─────────────────────────────────
# Gere com: openssl rand -base64 32
# Ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=cole_aqui_uma_string_aleatoria_de_32_bytes
NEXTAUTH_URL=http://localhost:3000

# ─── ANTHROPIC CLAUDE ──────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── RESEND (FASE 2 — email em massa) ──────────────────────
# Free tier: 3.000 emails/mês · 100/dia
# https://resend.com/api-keys
RESEND_API_KEY=re_...

# ─── GOOGLE PLACES API ─────────────────────────────────────
# Opcional — quando presente, substitui OSM como fonte de dados das empresas
# (traz rating, total de avaliações, aberto agora e link real do Google Maps)
# Console: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Habilite "Places API (New)" e gere uma chave com restrição de servidor.
GOOGLE_PLACES_API_KEY=AIza...

# ─── APP ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
